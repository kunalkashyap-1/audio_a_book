{
  "name": "@aab/contracts",
  "version": "0.2.0",
  "private": true,
  "description": "Generated TypeScript types — the FastAPI OpenAPI schema is the single source of truth",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "openapi.json",
    "src"
  ],
  "scripts": {
    "generate": "openapi-typescript ./openapi.json -o ./src/api.d.ts"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0"
  }
}
