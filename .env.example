# Copy to .env before `docker compose up`. Empty secrets keep single-operator mode.
AAB_TTS_PROVIDER=auto
AAB_ADMIN_TOKEN=
AAB_JWT_SECRET=
AAB_PUBLIC_BASE_URL=http://localhost:3000

# Internal Docker URL used by Next.js rewrites (not the browser-facing address).
AAB_API_URL=http://api:8000

# Host ports.
AAB_API_PORT=8000
AAB_WEB_PORT=3000

# Python extras baked into the image: dev (lean, fake voice) or kokoro,dev (real local TTS).
AAB_PY_EXTRAS=dev
